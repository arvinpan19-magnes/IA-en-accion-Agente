# Copia este archivo a ".env" (mismo directorio) y completa los valores ahí.
# NUNCA subas ".env" al repositorio ni pegues estos valores en el chat.

# Cuenta que envía los correos.
EMAIL_USER=tu_correo@gmail.com

# Si usas Gmail: contraseña de aplicación (no tu contraseña normal).
# Se genera en https://myaccount.google.com/apppasswords
# (requiere verificación en dos pasos activada en la cuenta).
EMAIL_PASSWORD=
